# Autodetect text files
* text=auto eol=lf

# ...Unless the name matches the following overriding patterns

# Definitively text files
*.bat  text
*.css  text
*.js   text
*.json text
*.json5 text
*.md   text
*.neon text
*.php  text
*.sql  text
*.svg text
*.txt  text
*.xml  text
*.yaml text
*.yml  text

# Ensure those won't be messed up with
*.gif  binary
*.jpg  binary
*.png  binary
*.ttf  binary
*.woff2 binary

# Exclude files from the archive
.agents                         export-ignore
.claude                         export-ignore
.env                            export-ignore
.env.*                          export-ignore
.env.example                    export-ignore
/.coderabbit.yaml               export-ignore
/.codex                         export-ignore
/.config/gh                     export-ignore
/.editorconfig                  export-ignore
/.gitattributes                 export-ignore
/.github                        export-ignore
/.gitignore                     export-ignore
/.idea                          export-ignore
/.nvmrc                         export-ignore
/.phpunit.cache                 export-ignore
/.prettierignore                export-ignore
/.prettierrc.json               export-ignore
/.stryker-tmp                   export-ignore
/.styleci.yml                   export-ignore
/.vscode                        export-ignore
/AGENTS.md                      export-ignore
/artifacts                      export-ignore
/code_coverage                  export-ignore
/codeception.yml                export-ignore
/composer-require-checker.json  export-ignore
/composer.lock                  export-ignore
/docs                           export-ignore
/ecs.php                        export-ignore
/infection.json*                export-ignore
/internal                       export-ignore
/node_modules                   export-ignore
/phpstan*.neon*                 export-ignore
/phpunit.xml.dist               export-ignore
/rector.php                     export-ignore
/reports                        export-ignore
/runtime                        export-ignore
/tests                          export-ignore
/vendor                         export-ignore

# Avoid merge conflicts in CHANGELOG
# https://about.gitlab.com/2015/02/10/gitlab-reduced-merge-conflicts-by-90-percent-with-changelog-placeholders/
/CHANGELOG.md merge=union
